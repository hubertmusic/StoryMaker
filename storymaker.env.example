# StoryMaker settings — copy this file to "storymaker.env" (same folder as storymaker.py)
# and fill in what you use. Lines starting with # are ignored. Keep this file private.

# ── API keys (only fill in the services you sign up for)
ANTHROPIC_API_KEY=        # Claude — story writing          console.anthropic.com
GEMINI_API_KEY=           # Google — video clips (+ can write, voice, pictures)   aistudio.google.com
ELEVENLABS_API_KEY=       # ElevenLabs — narrator voice     elevenlabs.io
OPENAI_API_KEY=           # optional — pictures/voice/writing
GROQ_API_KEY=             # optional — free story writing   console.groq.com

# ── Who writes the story: claude | gemini | openai | groq | ollama | demo
#    groq   = free tier (a daily limit), good open models, needs GROQ_API_KEY
#    ollama = runs on your own computer, completely free and private (install from ollama.com)
STORY_PROVIDER=claude

# ── Video: auto | omni | veo | slideshow | demo
#    auto = Gemini Omni video clips if GEMINI_API_KEY is set, else a picture slideshow
#    omni = Gemini Omni Flash (Google's default video model, about $0.10 per second at 720p)
#    veo  = Veo 3.1 (more camera control, costs more)
VIDEO_PROVIDER=auto
# A picture video can have its most dramatic scenes (fights, chases, turning points) animated as short clips with
# Veo (needs GEMINI_API_KEY; paid, about 8 seconds x PRICE_VEO_PER_SEC each). 0 = none. You can also pick it on the form.
BIG_MOMENTS=0
OMNI_MODEL=gemini-omni-1.1-flash
VEO_MODEL=veo-3.1-fast-generate-preview
VIDEO_RESOLUTION=720p
CLIP_SOUND_VOLUME=0.25     # each clip's own sound under the narrator (0 = mute it)
PARALLEL_CLIPS=3
CHARACTER_REF=on           # draw one character sheet first and show it to every clip

# ── Spending guard: runs estimated above this stop unless --yes is given (the shortcut asks you first)
MAX_COST_USD=10
#    Approximate prices used for the estimate — adjust to match your actual bills
PRICE_OMNI_PER_SEC=0.10
PRICE_VEO_PER_SEC=0.40
PRICE_IMAGE=0.05
PRICE_STORY_CLAUDE=0.06
PRICE_STORY_GEMINI=0.03    # set to 0 if you're on Google's free tier
PRICE_STORY_OPENAI=0.02
PRICE_STORY_GROQ=0
PRICE_STORY_OLLAMA=0
PRICE_VOICE_PER_MIN_OPENAI=0.015
PRICE_VOICE_PER_MIN_GEMINI=0.02
PRICE_VOICE_PER_MIN_ELEVENLABS=0   # comes out of your ElevenLabs plan credits

# ── Sound design: an AI sound designer reads each scene and picks its background (rain, harbor,
#    city, crickets…) and sound effects at the right moments (a knock, thunder, footsteps…).
#    Real recordings come from: 1) your own files in SOUNDS_DIR, named by what they are
#    (rain-heavy.mp3, door-knock.wav, female-moaning-1.mp3…), then 2) Freesound.org, a free library of
#    real recorded sounds: get a free API key at freesound.org/apiv2/apply and paste it below.
#    Downloaded sounds are kept in SOUNDS_DIR/library and reused; credits go in sound-credits.txt.
SOUNDSCAPES=on
SOUNDS_DIR=~/StoryMaker/sounds
FREESOUND_API_KEY=
AMBIENCE_VOLUME=1.0      # 0.5 quieter, 1.5 louder
EFFECTS_VOLUME=1.0
MAX_EFFECTS=3            # sound effects per scene at most
VOICE_POLISH=on          # studio voice chain: rumble cut, de-ess, gentle compression, clarity

# ── Background music: drop MP3/M4A files into MUSIC_DIR. A file whose name contains a word from
#    the genre is picked first (e.g. "adventure-theme.mp3" for "heartwarming adventure").
MUSIC=on
MUSIC_DIR=~/StoryMaker/music
MUSIC_VOLUME=0.18

# ── Notifications when a background run finishes (ntfy app on your iPhone, free)
NOTIFY=background          # background | always | off
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=                # a hard-to-guess name, e.g. storymaker-hub-7f3k9q
NTFY_TOKEN=                # only if your ntfy server needs a login

# ── Narrator: auto | elevenlabs | openai | gemini | kokoro | say | edge | espeak | silent
#    auto picks the first one you have a key for, in that order, then Kokoro (free, smooth, runs on
#    this computer), then the Mac voice
TTS_PROVIDER=auto
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_multilingual_v2
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_VOICE=Charon
OPENAI_VOICE=fable

# ── Character voices: multi = every speaking character gets their own voice; single = narrator only
VOICES=multi
#    Voice lists per type (female, male, girl, boy, old_woman, old_man, creature). Uncomment to change.
#ELEVENLABS_VOICES=female=21m00Tcm4TlvDq8ikWAM,EXAVITQu4vr4xnSDxMaL;male=pNInz6obpgDQGcFmaJgB,ErXwobaYiN019PkySvjV;girl=MF3mGyEYCl7XYWbV9V6O;boy=TxGEqnHWrfWFTfGW9XjX;old_woman=EXAVITQu4vr4xnSDxMaL;old_man=VR6AewLTigWG4xSOukaG;creature=yoZ06aMxZJJ28mfd3POQ
#OPENAI_VOICES=female=nova,shimmer,coral;male=onyx,echo,ash;girl=coral;boy=verse;old_woman=sage;old_man=ballad;creature=ash
#GEMINI_VOICES=female=Kore,Aoede;male=Puck,Orus;girl=Leda;boy=Puck;old_woman=Aoede;old_man=Fenrir;creature=Fenrir
#SAY_VOICES=female=Samantha,Karen;male=Daniel,Fred;girl=Kathy;boy=Junior;old_woman=Moira;old_man=Ralph;creature=Zarvox
SAY_VOICE=
EDGE_VOICE=en-US-AndrewMultilingualNeural
KOKORO_VOICE=af_heart          # narrator. Others: af_bella, bf_emma, am_michael, bm_george, bm_fable…
KOKORO_SPEED=0.95              # 0.9 slower and calmer, 1.0 normal
KOKORO_DIR=~/StoryMaker/kokoro # voice files download here the first time (about 120 MB)
#KOKORO_VOICES=female=af_bella,af_nicole,bf_emma;male=am_michael,am_fenrir,bm_george;girl=af_sky;boy=am_echo;old_woman=bf_alice;old_man=bm_lewis;creature=am_onyx

# ── Pictures (covers, the picture book, the slideshow video): auto | local | openai | gemini | cards
#    auto = your own picture app if LOCAL_IMAGE_URL is set (free), else OpenAI or Gemini if you have a key
IMAGE_PROVIDER=auto
#    Free pictures from Draw Things on your Mac (Settings → API Server → HTTP, port 7860).
#    For the web page in Docker use http://host.docker.internal:7860 ; for the Mac shortcut http://localhost:7860
LOCAL_IMAGE_URL=
# Steps and guidance: auto picks what suits the model Draw Things has loaded (a Turbo model needs ~6 steps and
# low guidance; a full SDXL model like Juggernaut XL ~30 steps). Or set numbers yourself.
LOCAL_IMAGE_STEPS=auto
LOCAL_IMAGE_CFG=auto
# The model for StoryMaker's pictures (its file name in Draw Things). Blank = whatever Draw Things has selected.
LOCAL_IMAGE_MODEL=
# How pictures look unless a story picks its own: storybook, realistic or cinematic
PICTURE_STYLE=storybook

# The address podcast apps use for your private feed (normally worked out by itself), e.g.
# PUBLIC_URL=https://optiplex.your-tailnet.ts.net
PUBLIC_URL=
COVER_ART=on              # paint a cover for every story when pictures are free
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=medium

# ── Writing models (update if a newer one comes out)
CLAUDE_MODEL=claude-sonnet-5-5
GEMINI_TEXT_MODEL=gemini-4-argon
OPENAI_TEXT_MODEL=gpt-5-mini
GROQ_MODEL=openai/gpt-oss-120b
# Groq's free plan allows a set amount a minute and a day. StoryMaker paces itself and waits out "too many
# requests"; if the day's allowance runs out, the rest of the story is written by Ollama on the Mac (off = stop
# instead, and press Recover later).
GROQ_FALLBACK=ollama
# Groq's tokens-a-minute allowance (8000 free; raise it if you upgrade)
GROQ_TPM=8000
# How hard gpt-oss thinks: auto = plans the story hard, scenes medium, small fixes briefly (or low/medium/high)
GROQ_REASONING=auto
OLLAMA_URL=http://localhost:11434     # in the Docker web page: http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b              # bigger = better stories but slower, e.g. llama3.1:70b or qwen2.5:32b

# ── Reading level used when you don't pick one:
#    young-kids | kids | middle-grade | teen | adult | mature | family   (explicit must be picked each time)
LEVEL=family

# ── Explicit (18+) level: off until you turn it on. It always uses Ollama on this computer
#    (the online AIs don't allow it and could shut off your keys), a local voice, and no pictures or video.
ADULT_CONTENT=off
OLLAMA_ADULT_MODEL=dolphin3      # better on a 16 GB Mac: hf.co/bartowski/TheDrummer_Rocinante-X-12B-v1-GGUF:Q4_K_M
OLLAMA_TEMPERATURE=0.9           # livelier writing (0.7 calmer and safer, 1.0 wilder)
OLLAMA_KEEP_ALIVE=30s            # frees the writer's memory soon after, for the voices and pictures

# ── Picture-book PDF: made automatically in video mode (free — uses the video's pictures).
#    In story/audio mode add --book (it then draws pictures, which costs a little).
BOOK=on

# ── Where finished stories go
OUTPUT_DIR=~/StoryMaker/output

# ── Server only: copy results into a folder your web server serves so your iPhone can download them
PUBLIC_DIR=
PUBLIC_BASE_URL=
#    If the output folder itself is served (the StoryMaker web page does this at /media), set this
#    instead and nothing is copied. Leave blank otherwise — the web page sets it for itself.
MEDIA_BASE_URL=

# ── Video look
CAPTIONS=on                # subtitles burned into the video, a line at a time as it's spoken
SUBTITLES=on               # also write story.srt and story.vtt (subtitle files players can turn on/off)
MOTION=on
# With free pictures from your own picture app, long scenes get a new picture of a later moment every
# SECONDS_PER_PICTURE seconds (up to 4 per scene), with a soft fade between them.
MORE_PICTURES=on
SECONDS_PER_PICTURE=40

# ── Overnight list, phone notifications, status page ──
# Your time zone, so "tonight" means your night (the server's own clock may be on UTC).
TZ=America/New_York
# "Make it tonight" stories are made between these times (24-hour clock), one after another.
QUEUE_START=23:00
QUEUE_END=06:30
# Phone notifications use ntfy (free app). Turn them on in Settings. To use your own ntfy server, put it here.
NTFY_URL=https://ntfy.sh
