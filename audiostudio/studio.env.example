# Audio Studio settings. Keys, Freesound, Ollama and sound settings come from ../storymaker.env.

# Where StoryMaker is (sign-in and stories come from it)
STORYMAKER_URL=http://localhost:8095

# The studio's own port
STUDIO_PORT=8096

# Voices for new books: chatterbox (natural, emotional) or kokoro (fast drafts)
STUDIO_ENGINE=chatterbox

# Chatterbox: standard (best acting, uses emotions) or turbo (faster, less acting)
CHATTERBOX_MODEL=standard
CHATTERBOX_DEVICE=auto
# Chatterbox is restarted fresh (a few seconds) to hand its memory back to the Mac: after this many lines,
# or sooner if it holds this many GB. Lower them if recording still runs out of memory.
CHATTERBOX_RECYCLE_LINES=15
CHATTERBOX_RECYCLE_GB=3

# Projects, recordings and finished books
STUDIO_DIR=~/StoryMaker/studio

# Optional: the StoryMaker link at the top of the page (blank = same address, port 8095)
STORYMAKER_PUBLIC_URL=

# Draw Things forgets its API Server switch every time it closes. The studio turns it back on by itself
# (allow "Python" once in System Settings → Privacy & Security → Accessibility). off = leave Draw Things alone.
DRAW_THINGS_ALWAYS_ON=on
# Open Draw Things again if it's been quit (off = only switch the server on while Draw Things is open)
DRAW_THINGS_REOPEN=on
